//@version=6
indicator("ASJR - Asia Range Breakout / Retest", overlay=true, max_labels_count=500)

// -------------------- Inputs --------------------
string tz = input.string("Europe/London", "Session timezone")
string asiaSession = input.session("0000-0700:23456", "Asia range")
string londonWindow = input.session("0700-1200:23456", "NQ London entry window")
string stockWindow = input.session("0700-2100:23456", "Stock signal window")

// NQ reference settings. For stocks these are automatically scaled.
float nqReferencePrice = input.float(31500.0, "NQ reference price for auto-scaling", minval=1000.0)
float bufferPts = input.float(2.0, "NQ breakout buffer (points)", minval=0.0, step=0.25)
float swingAwayPts = input.float(10.0, "NQ minimum move away (points)", minval=1.0, step=0.25)
float retestTolerance = input.float(5.0, "NQ retest tolerance (points)", minval=0.0, step=0.25)
float retestLabelOffset = input.float(12.0, "NQ retest label offset (points)", minval=1.0, step=1.0)

int minRetestBars = input.int(3, "Minimum bars before pullback", minval=2, maxval=20)
int maxRetestBars = input.int(12, "Maximum bars before pullback", minval=3, maxval=48)

bool autoScaleStocks = input.bool(true, "Auto-scale NQ point settings for stocks")
bool requireFullAsia = input.bool(false, "Require full Asia-session data")
float minAsiaCoveragePct = input.float(80.0, "Minimum Asia-session coverage %", minval=10.0, maxval=100.0, step=5.0)

bool showAsiaFill = input.bool(true, "Shade Asia session")
bool showImmediate = input.bool(true, "Mark breakout candle")
bool showRetest = input.bool(true, "Mark confirmed retest candle")
bool showCoverageWarning = input.bool(true, "Show missing-session warning")

// -------------------- Symbol-aware settings --------------------
bool isStock = syminfo.type == "stock"

// Stocks such as INTC do not trade like NQ overnight and their US-session
// breakout often happens after 12:00 London. Keep NQ on the London window,
// but allow stocks through the normal US cash session.
bool inSignalWindow = isStock ? not na(time(timeframe.period, stockWindow, tz)) : not na(time(timeframe.period, londonWindow, tz))

// Scale NQ point distances to the current stock price.
// Minimums based on mintick stop values becoming effectively zero.
float scale = isStock and autoScaleStocks ? close / nqReferencePrice : 1.0
float effectiveBuffer = isStock and autoScaleStocks ? math.max(syminfo.mintick * 2.0, bufferPts * scale) : bufferPts
float effectiveSwingAway = isStock and autoScaleStocks ? math.max(syminfo.mintick * 10.0, swingAwayPts * scale) : swingAwayPts
float effectiveRetestTolerance = isStock and autoScaleStocks ? math.max(syminfo.mintick * 5.0, retestTolerance * scale) : retestTolerance
float effectiveLabelOffset = isStock and autoScaleStocks ? math.max(syminfo.mintick * 12.0, retestLabelOffset * scale) : retestLabelOffset

// -------------------- Session state --------------------
bool inAsia = not na(time(timeframe.period, asiaSession, tz))
bool asiaStart = inAsia and not inAsia[1]
bool asiaEnd = not inAsia and inAsia[1]

float tfSeconds = timeframe.in_seconds()
int expectedAsiaBars = tfSeconds > 0 ? int(math.round(7.0 * 60.0 * 60.0 / tfSeconds)) : 0
int minimumAsiaBars = expectedAsiaBars > 0 ? int(math.ceil(expectedAsiaBars * minAsiaCoveragePct / 100.0)) : 1

var float asiaHigh = na
var float asiaLow = na
var int asiaBarCount = 0
var bool rangeReady = false
var bool asiaCoverageOK = false

if asiaStart
    asiaHigh := high
    asiaLow := low
    asiaBarCount := 1
    rangeReady := false
    asiaCoverageOK := false
else if inAsia
    asiaHigh := math.max(nz(asiaHigh, high), high)
    asiaLow := math.min(nz(asiaLow, low), low)
    asiaBarCount += 1

if asiaEnd
    asiaCoverageOK := not requireFullAsia or asiaBarCount >= minimumAsiaBars
    rangeReady := asiaCoverageOK

float plottedAsiaHigh = rangeReady or inAsia ? asiaHigh : na
float plottedAsiaLow = rangeReady or inAsia ? asiaLow : na

plot(plottedAsiaHigh, "Asia High", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(plottedAsiaLow, "Asia Low", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
bgcolor(showAsiaFill and inAsia ? color.new(color.blue, 92) : na, title="Asia Session")

// -------------------- Coverage warning --------------------
var table coverageTable = table.new(position.top_right, 1, 1)
if barstate.islast
    bool badCoverage = requireFullAsia and not inAsia and not asiaCoverageOK
    if showCoverageWarning and badCoverage
        table.cell(coverageTable, 0, 0, "NO FULL ASIA DATA\nSignals disabled", text_color=color.white, bgcolor=color.new(color.red, 10))
    else
        table.cell(coverageTable, 0, 0, "", bgcolor=color.new(color.black, 100))

// -------------------- Breakout candle --------------------
var bool breakoutTriggered = false
var int breakoutDirection = 0
var int breakoutBar = na
var bool movedAway = false
var bool retestTriggered = false

var bool pullbackPending = false
var int pullbackBar = na
var float pullbackHigh = na
var float pullbackLow = na

bool signalWindowStart = inSignalWindow and not inSignalWindow[1]
if signalWindowStart
    breakoutTriggered := false
    breakoutDirection := 0
    breakoutBar := na
    movedAway := false
    retestTriggered := false
    pullbackPending := false
    pullbackBar := na
    pullbackHigh := na
    pullbackLow := na

// First CLOSED candle beyond the Asia boundary + small symbol-aware buffer.
bool longBreak = rangeReady and asiaCoverageOK and inSignalWindow and not breakoutTriggered and close > asiaHigh + effectiveBuffer
bool shortBreak = rangeReady and asiaCoverageOK and inSignalWindow and not breakoutTriggered and close < asiaLow - effectiveBuffer

if longBreak
    breakoutTriggered := true
    breakoutDirection := 1
    breakoutBar := bar_index

if shortBreak
    breakoutTriggered := true
    breakoutDirection := -1
    breakoutBar := bar_index

plotshape(showImmediate and longBreak, title="Long Breakout Candle", style=shape.labeldown, location=location.abovebar, text="BREAKOUT\nCANDLE", color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
plotshape(showImmediate and shortBreak, title="Short Breakout Candle", style=shape.labelup, location=location.belowbar, text="BREAKOUT\nCANDLE", color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)

// -------------------- Pullback -> confirmation retest --------------------
bool afterBreakout = breakoutTriggered and not na(breakoutBar) and bar_index > breakoutBar

if afterBreakout and not movedAway
    if breakoutDirection == 1 and high >= asiaHigh + effectiveSwingAway
        movedAway := true
    if breakoutDirection == -1 and low <= asiaLow - effectiveSwingAway
        movedAway := true

int barsAfterBreak = not na(breakoutBar) ? bar_index - breakoutBar : 0
bool pullbackWindowOpen = breakoutTriggered and movedAway and not retestTriggered and inSignalWindow and barsAfterBreak >= minRetestBars and barsAfterBreak <= maxRetestBars

// Retest label goes on the candle AFTER the pullback candle,
// only when that candle confirms continuation.
bool longRetest = pullbackPending and breakoutDirection == 1 and bar_index == pullbackBar + 1 and close > open and close > pullbackHigh and close > asiaHigh + effectiveBuffer
bool shortRetest = pullbackPending and breakoutDirection == -1 and bar_index == pullbackBar + 1 and close < open and close < pullbackLow and close < asiaLow - effectiveBuffer

if longRetest or shortRetest
    retestTriggered := true
    pullbackPending := false

if pullbackPending and bar_index > pullbackBar
    if not longRetest and not shortRetest
        pullbackPending := false

if pullbackWindowOpen and not pullbackPending and not retestTriggered
    if breakoutDirection == 1 and low <= asiaHigh + effectiveRetestTolerance
        pullbackPending := true
        pullbackBar := bar_index
        pullbackHigh := high
        pullbackLow := low
    else if breakoutDirection == -1 and high >= asiaLow - effectiveRetestTolerance
        pullbackPending := true
        pullbackBar := bar_index
        pullbackHigh := high
        pullbackLow := low

float longRetestY = longRetest ? low - effectiveLabelOffset : na
float shortRetestY = shortRetest ? high + effectiveLabelOffset : na

plotshape(showRetest ? longRetestY : na, title="Long Retest Confirmation Candle", style=shape.labelup, location=location.absolute, text="RETEST\nCANDLE", color=color.new(color.blue, 0), textcolor=color.white, size=size.tiny)
plotshape(showRetest ? shortRetestY : na, title="Short Retest Confirmation Candle", style=shape.labeldown, location=location.absolute, text="RETEST\nCANDLE", color=color.new(color.orange, 0), textcolor=color.white, size=size.tiny)

// Alerts
alertcondition(longBreak, "Asia High Breakout", "Price closed above Asia High")
alertcondition(shortBreak, "Asia Low Breakout", "Price closed below Asia Low")
alertcondition(longRetest, "Long Retest Confirmation", "Bullish candle confirms Asia High retest")
alertcondition(shortRetest, "Short Retest Confirmation", "Bearish candle confirms Asia Low retest")
