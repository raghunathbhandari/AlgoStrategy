//@version=6
indicator("ASJR - NQ Asia Range -> London Breakout", overlay=true, max_labels_count=500)

// -------------------- Inputs --------------------
string tz = input.string("Europe/London", "Session timezone")
string asiaSession = input.session("0000-0700:23456", "Asia range")
string londonWindow = input.session("0700-1200:23456", "London entry window")
float bufferPts = input.float(2.0, "Breakout buffer (NQ points)", minval=0.0, step=0.25)

int minRetestBars = input.int(3, "Minimum bars before retest", minval=2, maxval=20)
int maxRetestBars = input.int(12, "Maximum bars before retest", minval=3, maxval=48)
float swingAwayPts = input.float(10.0, "Minimum move away before retest", minval=1.0, step=0.25)
float retestTolerance = input.float(5.0, "Retest tolerance (points)", minval=0.0, step=0.25)
float retestLabelOffset = input.float(12.0, "Retest label offset (points)", minval=1.0, step=1.0)

bool showAsiaFill = input.bool(true, "Shade Asia session")
bool showImmediate = input.bool(true, "Mark breakout candle")
bool showRetest = input.bool(true, "Mark swing retest candle")

// -------------------- Session state --------------------
bool inAsia = not na(time(timeframe.period, asiaSession, tz))
bool inLondon = not na(time(timeframe.period, londonWindow, tz))
bool asiaStart = inAsia and not inAsia[1]
bool asiaEnd = not inAsia and inAsia[1]

var float asiaHigh = na
var float asiaLow = na
var bool rangeReady = false

if asiaStart
    asiaHigh := high
    asiaLow := low
    rangeReady := false
else if inAsia
    asiaHigh := math.max(nz(asiaHigh, high), high)
    asiaLow := math.min(nz(asiaLow, low), low)

if asiaEnd
    rangeReady := true

plot(rangeReady or inAsia ? asiaHigh : na, "Asia High", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(rangeReady or inAsia ? asiaLow : na, "Asia Low", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
bgcolor(showAsiaFill and inAsia ? color.new(color.blue, 92) : na, title="Asia Session")

// -------------------- Breakout candle --------------------
var bool breakoutTriggered = false
var int breakoutDirection = 0
var int breakoutBar = na
var bool movedAway = false
var bool retestTriggered = false

bool londonStart = inLondon and not inLondon[1]
if londonStart
    breakoutTriggered := false
    breakoutDirection := 0
    breakoutBar := na
    movedAway := false
    retestTriggered := false

bool longBreak = rangeReady and inLondon and not breakoutTriggered and close > asiaHigh + bufferPts
bool shortBreak = rangeReady and inLondon and not breakoutTriggered and close < asiaLow - bufferPts

if longBreak
    breakoutTriggered := true
    breakoutDirection := 1
    breakoutBar := bar_index

if shortBreak
    breakoutTriggered := true
    breakoutDirection := -1
    breakoutBar := bar_index

plotshape(showImmediate and longBreak, title="Long Breakout Candle", style=shape.labeldown, location=location.abovebar, text="BREAKOUT\nCANDLE", color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
plotshape(showImmediate and shortBreak, title="Short Breakout Candle", style=shape.labelup, location=location.belowbar, text="BREAKOUT\nCANDLE", color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)

// -------------------- Swing retest candle --------------------
// A valid retest must NOT be the next candle.
// First, price must make a meaningful move away from the broken Asia level.
// Then it must pull back to the broken level and reject/hold it.

bool afterBreakout = breakoutTriggered and not na(breakoutBar) and bar_index > breakoutBar

if afterBreakout and not movedAway
    if breakoutDirection == 1 and high >= asiaHigh + swingAwayPts
        movedAway := true
    if breakoutDirection == -1 and low <= asiaLow - swingAwayPts
        movedAway := true

int barsAfterBreak = not na(breakoutBar) ? bar_index - breakoutBar : 0
bool retestWindowOpen = breakoutTriggered and movedAway and not retestTriggered and inLondon and barsAfterBreak >= minRetestBars and barsAfterBreak <= maxRetestBars

// Long retest: pullback reaches the old Asia High area, closes back above it,
// and the confirmation candle is bullish.
// Short retest: pullback reaches the old Asia Low area, closes back below it,
// and the confirmation candle is bearish.
bool longRetest = retestWindowOpen and breakoutDirection == 1 and low <= asiaHigh + retestTolerance and close > asiaHigh + bufferPts and close > open
bool shortRetest = retestWindowOpen and breakoutDirection == -1 and high >= asiaLow - retestTolerance and close < asiaLow - bufferPts and close < open

if longRetest or shortRetest
    retestTriggered := true

float longRetestY = longRetest ? low - retestLabelOffset : na
float shortRetestY = shortRetest ? high + retestLabelOffset : na

plotshape(showRetest ? longRetestY : na, title="Long Swing Retest Candle", style=shape.labelup, location=location.absolute, text="RETEST\nCANDLE", color=color.new(color.blue, 0), textcolor=color.white, size=size.tiny)
plotshape(showRetest ? shortRetestY : na, title="Short Swing Retest Candle", style=shape.labeldown, location=location.absolute, text="RETEST\nCANDLE", color=color.new(color.orange, 0), textcolor=color.white, size=size.tiny)

// Alerts
alertcondition(longBreak, "NQ Asia High Breakout", "NQ: 5m close above Asia High")
alertcondition(shortBreak, "NQ Asia Low Breakout", "NQ: 5m close below Asia Low")
alertcondition(longRetest, "NQ Long Swing Retest", "NQ: Asia High breakout swing retest continuation")
alertcondition(shortRetest, "NQ Short Swing Retest", "NQ: Asia Low breakout swing retest continuation")
