//@version=6
indicator("ASJR - NQ Asia Range -> London Breakout", overlay=true, max_labels_count=500)

// -------------------- Inputs --------------------
string tz = input.string("Europe/London", "Session timezone")
string asiaSession = input.session("0000-0700:23456", "Asia range")
string londonWindow = input.session("0700-1200:23456", "London entry window")
float bufferPts = input.float(2.0, "Breakout buffer (NQ points)", minval=0.0, step=0.25)

int minRetestBars = input.int(3, "Minimum bars before pullback", minval=2, maxval=20)
int maxRetestBars = input.int(12, "Maximum bars before pullback", minval=3, maxval=48)
float swingAwayPts = input.float(10.0, "Minimum move away before pullback", minval=1.0, step=0.25)
float retestTolerance = input.float(5.0, "Retest tolerance (points)", minval=0.0, step=0.25)
float retestLabelOffset = input.float(12.0, "Retest label offset (points)", minval=1.0, step=1.0)

bool requireFullAsia = input.bool(true, "Require full Asia-session data")
float minAsiaCoveragePct = input.float(80.0, "Minimum Asia-session coverage %", minval=10.0, maxval=100.0, step=5.0)

bool showAsiaFill = input.bool(true, "Shade Asia session")
bool showImmediate = input.bool(true, "Mark breakout candle")
bool showRetest = input.bool(true, "Mark confirmed retest candle")
bool showCoverageWarning = input.bool(true, "Show missing-session warning")

// -------------------- Session state --------------------
bool inAsia = not na(time(timeframe.period, asiaSession, tz))
bool inLondon = not na(time(timeframe.period, londonWindow, tz))
bool asiaStart = inAsia and not inAsia[1]
bool asiaEnd = not inAsia and inAsia[1]

// The Asia session is 00:00-07:00 London = 7 hours.
// NQ/MNQ trade through this window. US stocks such as INTC do not.
// Without a coverage check, TradingView can incorrectly treat only the final
// after-hours bars as the "Asia range" and carry that false range into London.
float tfSeconds = timeframe.in_seconds()
int expectedAsiaBars = tfSeconds > 0 ? int(math.round(7.0 * 60.0 * 60.0 / tfSeconds)) : 0
int minimumAsiaBars = expectedAsiaBars > 0 ? int(math.ceil(expectedAsiaBars * minAsiaCoveragePct / 100.0)) : 1

var float asiaHigh = na
var float asiaLow = na
var int asiaBarCount = 0
var bool rangeReady = false
var bool asiaCoverageOK = false

if asiaStart
    asiaHigh := high
    asiaLow := low
    asiaBarCount := 1
    rangeReady := false
    asiaCoverageOK := false
else if inAsia
    asiaHigh := math.max(nz(asiaHigh, high), high)
    asiaLow := math.min(nz(asiaLow, low), low)
    asiaBarCount += 1

if asiaEnd
    asiaCoverageOK := not requireFullAsia or asiaBarCount >= minimumAsiaBars
    rangeReady := asiaCoverageOK

// If the symbol has no proper 00:00-07:00 London market data, do not draw
// a misleading Asia range or fire breakout/retest signals.
float plottedAsiaHigh = (rangeReady or inAsia) and (not requireFullAsia or inAsia or asiaCoverageOK) ? asiaHigh : na
float plottedAsiaLow = (rangeReady or inAsia) and (not requireFullAsia or inAsia or asiaCoverageOK) ? asiaLow : na

plot(plottedAsiaHigh, "Asia High", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(plottedAsiaLow, "Asia Low", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
bgcolor(showAsiaFill and inAsia ? color.new(color.blue, 92) : na, title="Asia Session")

// -------------------- Coverage warning --------------------
var table coverageTable = table.new(position.top_right, 1, 1)
if barstate.islast
    bool badCoverage = requireFullAsia and not inAsia and not asiaCoverageOK
    if showCoverageWarning and badCoverage
        table.cell(coverageTable, 0, 0, "NO FULL ASIA DATA\nSignals disabled", text_color=color.white, bgcolor=color.new(color.red, 10))
    else
        table.cell(coverageTable, 0, 0, "", bgcolor=color.new(color.black, 100))

// -------------------- Breakout candle --------------------
var bool breakoutTriggered = false
var int breakoutDirection = 0
var int breakoutBar = na
var bool movedAway = false
var bool retestTriggered = false

// Pullback candle state.
// The RETEST label is NOT placed on this pullback candle.
// It is placed only on the NEXT confirmation/continuation candle.
var bool pullbackPending = false
var int pullbackBar = na
var float pullbackHigh = na
var float pullbackLow = na

bool londonStart = inLondon and not inLondon[1]
if londonStart
    breakoutTriggered := false
    breakoutDirection := 0
    breakoutBar := na
    movedAway := false
    retestTriggered := false
    pullbackPending := false
    pullbackBar := na
    pullbackHigh := na
    pullbackLow := na

bool longBreak = rangeReady and asiaCoverageOK and inLondon and not breakoutTriggered and close > asiaHigh + bufferPts
bool shortBreak = rangeReady and asiaCoverageOK and inLondon and not breakoutTriggered and close < asiaLow - bufferPts

if longBreak
    breakoutTriggered := true
    breakoutDirection := 1
    breakoutBar := bar_index

if shortBreak
    breakoutTriggered := true
    breakoutDirection := -1
    breakoutBar := bar_index

plotshape(showImmediate and longBreak, title="Long Breakout Candle", style=shape.labeldown, location=location.abovebar, text="BREAKOUT\nCANDLE", color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
plotshape(showImmediate and shortBreak, title="Short Breakout Candle", style=shape.labelup, location=location.belowbar, text="BREAKOUT\nCANDLE", color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)

// -------------------- Swing pullback -> confirmation retest --------------------
bool afterBreakout = breakoutTriggered and not na(breakoutBar) and bar_index > breakoutBar

if afterBreakout and not movedAway
    if breakoutDirection == 1 and high >= asiaHigh + swingAwayPts
        movedAway := true
    if breakoutDirection == -1 and low <= asiaLow - swingAwayPts
        movedAway := true

int barsAfterBreak = not na(breakoutBar) ? bar_index - breakoutBar : 0
bool pullbackWindowOpen = breakoutTriggered and movedAway and not retestTriggered and inLondon and barsAfterBreak >= minRetestBars and barsAfterBreak <= maxRetestBars

// Confirmation must be the candle immediately AFTER the pullback/swing candle.
bool longRetest = pullbackPending and breakoutDirection == 1 and bar_index == pullbackBar + 1 and close > open and close > pullbackHigh and close > asiaHigh + bufferPts
bool shortRetest = pullbackPending and breakoutDirection == -1 and bar_index == pullbackBar + 1 and close < open and close < pullbackLow and close < asiaLow - bufferPts

if longRetest or shortRetest
    retestTriggered := true
    pullbackPending := false

// If the next candle did not confirm, release the candidate and allow a later swing pullback.
if pullbackPending and bar_index > pullbackBar
    if not longRetest and not shortRetest
        pullbackPending := false

// Find the swing pullback candle.
// LONG: pullback reaches old Asia High area after price moved away.
// SHORT: pullback reaches old Asia Low area after price moved away.
if pullbackWindowOpen and not pullbackPending and not retestTriggered
    if breakoutDirection == 1 and low <= asiaHigh + retestTolerance
        pullbackPending := true
        pullbackBar := bar_index
        pullbackHigh := high
        pullbackLow := low
    else if breakoutDirection == -1 and high >= asiaLow - retestTolerance
        pullbackPending := true
        pullbackBar := bar_index
        pullbackHigh := high
        pullbackLow := low

float longRetestY = longRetest ? low - retestLabelOffset : na
float shortRetestY = shortRetest ? high + retestLabelOffset : na

plotshape(showRetest ? longRetestY : na, title="Long Retest Confirmation Candle", style=shape.labelup, location=location.absolute, text="RETEST\nCANDLE", color=color.new(color.blue, 0), textcolor=color.white, size=size.tiny)
plotshape(showRetest ? shortRetestY : na, title="Short Retest Confirmation Candle", style=shape.labeldown, location=location.absolute, text="RETEST\nCANDLE", color=color.new(color.orange, 0), textcolor=color.white, size=size.tiny)

// Alerts
alertcondition(longBreak, "NQ Asia High Breakout", "NQ: 5m close above Asia High")
alertcondition(shortBreak, "NQ Asia Low Breakout", "NQ: 5m close below Asia Low")
alertcondition(longRetest, "NQ Long Retest Confirmation", "NQ: bullish candle confirms Asia High swing retest")
alertcondition(shortRetest, "NQ Short Retest Confirmation", "NQ: bearish candle confirms Asia Low swing retest")
